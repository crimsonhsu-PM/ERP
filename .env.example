# 本機 SQLite 連線；例如 file:./dev.db。
DATABASE_URL=
# 簽署登入工作階段；正式環境必須自行產生長隨機值。
SESSION_SECRET=
# LINE Webhook 驗簽用的 Channel Secret。
LINE_CHANNEL_SECRET=
# LINE Messaging API 存取權杖。
LINE_CHANNEL_ACCESS_TOKEN=
# 可使用 LINE 功能的使用者 ID，依程式要求設定。
LINE_ALLOWED_USER_IDS=
# LINE 測試時使用的使用者 ID（如需執行相關腳本）。
LINE_TEST_USER_ID=
# OpenAI API 金鑰；僅啟用相關 AI 功能時設定。
OPENAI_API_KEY=
# OpenAI 模型名稱；僅啟用相關 AI 功能時設定。
OPENAI_MODEL=
